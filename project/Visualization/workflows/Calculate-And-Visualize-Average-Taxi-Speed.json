        {
          "name": "sql",
          "value": "select temptable.medallion , temptable.pickup_datetime_hour, \n\ncase when (temptable.trip_time_in_secs = 0 or temptable.trip_distance = 0.0) then 0.0 else (temptable.trip_distance*60*60)/temptable.trip_time_in_secs end \nas speed from temptable",
